# copy_block - Copy src to dest and return xor checksum of src
	.pos 0
	irmovq stack,%rsp
	call main
	halt

.align 8
# Source block
src:
	.quad 0x00a
	.quad 0x0b0
	.quad 0xc00
# Destination block
dest:
	.quad 0x111
	.quad 0x222
	.quad 0x333

main:
	irmovq src,%rdi
	irmovq dest,%rsi
	irmovq $3,%rdx
	call copy_block
	ret

copy_block:
	irmovq $0,%rax
	irmovq $8,%r8
	irmovq $1,%r9
L1:
	andq %rdx,%rdx
	je L2
	mrmovq (%rdi),%rcx
	rmmovq %rcx,(%rsi)
	addq %r8,%rdi
	addq %r8,%rsi
	xorq %rcx,%rax
	subq %r9,%rdx
	jmp L1
L2:
	ret

	.pos 0x200
stack:
