# rsum_list - Recursive version of sum_list

	.pos 0
	irmovq stack,%rsp
	call main
	halt

# Sample linked list
	.align 8
ele1:
	.quad 0x00a
	.quad ele2
ele2:
	.quad 0x0b0
	.quad ele3
ele3:
	.quad 0xc00
	.quad 0

main:
	irmovq ele1,%rdi
	call rsum_list
	ret

rsum_list:
	irmovq $0,%rax
	andq %rdi,%rdi
	je L1
	mrmovq 0(%rdi),%rcx
	pushq %rcx
	mrmovq 8(%rdi),%rdi
	call rsum_list
	popq %rcx
	addq %rcx,%rax
L1:
	ret

	.pos 0x200
stack:
